# Vidio backend configuration (see crates/http-api and apps/api)
#
# Copy to `.env` for docker compose / local runs:
#   cp .env.example .env
#
# Connecting vidio-web? That app needs its own `.env.local` — see
# `examples/vidio-web.env.local` (VIDIO_API_BASE_URL / NEXT_PUBLIC_API_BASE_URL).

VIDIO_BIND_ADDR=0.0.0.0:8080
VIDIO_ACCESS_TOKEN_SECRET=change-me-in-production-min-32-bytes-long
VIDIO_ACCESS_TOKEN_TTL_SECS=900
VIDIO_REFRESH_TOKEN_TTL_SECS=2592000
VIDIO_ADDON_FETCH_TIMEOUT_MS=8000
VIDIO_ADDON_MAX_RESPONSE_BYTES=5242880
VIDIO_ADDON_ALLOW_PRIVATE_NETWORKS=false
RUST_LOG=info
