# Copy this file into the vidio-web repo as `.env.local`, then restart `pnpm dev`.
#
#   cp examples/vidio-web.env.local /path/to/vidio-web/.env.local
#
# Without these, registration/login via the Next.js BFF returns:
#   {"type":"/errors/internal","status":500,"detail":"VIDIO_API_BASE_URL is not configured"}
#
# Point both URLs at the Rust API origin only (no /v1 suffix).

# Browser → Rust API (direct data calls with bearer token)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# BFF Route Handlers → Rust API (server-only; never expose refresh tokens to the browser)
VIDIO_API_BASE_URL=http://localhost:8080

# Refresh token cookie (httpOnly, path=/api/auth)
VIDIO_REFRESH_COOKIE_NAME=vidio_refresh_token
